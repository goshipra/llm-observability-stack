# ============================================================================
# SECURITY: Credentials, Secrets, Personal Data — ZERO TOLERANCE POLICY
# ============================================================================
# NO environment variables, API keys, SSH keys, passwords, or personal data
# should EVER be committed to this repo.

# Environment variables & configuration (CRITICAL)
.env
.env.local
.env.*.local
.env.production.local

# Credentials & Secrets (CRITICAL)
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
*.pub                          # SSH public keys (usually safe but double-check)
credentials.json
credentials.yaml
secrets.yaml
secrets.json
secrets.env
.aws/
.gcp/
~/.kube/config

# API Keys & Tokens (CRITICAL)
.api_keys
.tokens
auth_token
api_key
access_token
refresh_token

# Cloud credentials (CRITICAL)
